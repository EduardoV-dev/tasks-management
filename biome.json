{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": ["**", "!**/.next", "!**/.turbo", "!**/coverage", "!**/dist", "!**/node_modules"]
  },
  "formatter": {
    "indentStyle": "space",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "indentWidth": 2,
    "lineWidth": 100,
    "trailingNewline": true,
    "lineEnding": "auto"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useImportType": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
